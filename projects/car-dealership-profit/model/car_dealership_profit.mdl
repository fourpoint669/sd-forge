{UTF-8}
Prospects=
	INTEG ((market entries + marketing starts + repeat to store) - (new sales + used sales), initial prospects)
	~	Household
	~	Material. Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Owners=
	INTEG ((retail new buys + used sales) - replacement, initial owners)
	~	Household
	~	Material (ownership period). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Lessees Early=
	INTEG (lease starts - lease advance 1, initial lessees per stage)
	~	Household
	~	Material (lease stage 1). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Lessees Mid=
	INTEG (lease advance 1 - lease advance 2, initial lessees per stage)
	~	Household
	~	Material (lease stage 2). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Lessees Late=
	INTEG (lease advance 2 - lease end, initial lessees per stage)
	~	Household
	~	Material (lease stage 3). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Households Elsewhere=
	INTEG (leakage, 0)
	~	Household
	~	Material sink (bought or leased at other stores). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Households Outside Market=
	INTEG (-(market entries + marketing starts), (market entry rate + maximum marketing starts) * simulation horizon)
	~	Household
	~	Material source. Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

New Inventory=
	INTEG (deliveries - new sales * vehicles per household purchase, initial new inventory)
	~	Vehicle
	~	Material. Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

New Vehicles On Order=
	INTEG (new orders - deliveries, initial new vehicles on order)
	~	Vehicle
	~	Material (order lead time). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Used Frontline Inventory=
	INTEG (recon done - (used sales * vehicles per household purchase + wholesale exits), initial used frontline inventory)
	~	Vehicle
	~	Material. Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Reconditioning Pipeline=
	INTEG (used acquisitions - recon done, initial reconditioning pipeline)
	~	Vehicle
	~	Material (reconditioning time). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Manufacturer Supply Outside=
	INTEG (-new orders, manufacturer allocation * simulation horizon)
	~	Vehicle
	~	Material source (bounded by the allocation cap). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

New Vehicles Sold=
	INTEG (new sales * vehicles per household purchase, 0)
	~	Vehicle
	~	Material sink. Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Used Vehicle Supply Outside=
	INTEG (-used acquisitions, initial used supply outside)
	~	Vehicle
	~	Material source. Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Used Vehicles Sold On=
	INTEG ((used sales * vehicles per household purchase + wholesale exits), 0)
	~	Vehicle
	~	Material sink. Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Trailing New Sales=
	INTEG (trailing change, reference new sales)
	~	Household/Month
	~	Information (allocation memory). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Trailing Used Sales=
	INTEG (trailing used change, reference used sales)
	~	Household/Month
	~	Information (used sales memory). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Service Customers=
	INTEG (service capture - defection, initial service customers)
	~	Household
	~	Material subset of the customer base. Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Technicians=
	INTEG (hiring - attrition, initial technicians)
	~	Technician
	~	Resource (hiring delay). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Inventory at Cost=
	INTEG ((deliveries * new vehicle unit cost + used acquisitions * used vehicle unit cost) - inventory cost released, initial inventory at cost)
	~	USD
	~	Money (valued at unit cost). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Floorplan Debt=
	INTEG ((advance rate * (deliveries * new vehicle unit cost + used acquisitions * used vehicle unit cost)) - floorplan payoff, initial floorplan debt)
	~	USD
	~	Money. Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Cash Received=
	INTEG (MAX(0, net cash flow), 0)
	~	USD
	~	Accumulator (non-negative part of cash flow). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Cash Paid Out=
	INTEG ((MAX(0, 0 - net cash flow)), 0)
	~	USD
	~	Accumulator (non-negative part of cash flow). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Cumulative Profit Earned=
	INTEG (MAX(0, net profit), 0)
	~	USD
	~	Accumulator (non-negative part of net profit). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Cumulative Loss Incurred=
	INTEG ((MAX(0, 0 - net profit)), 0)
	~	USD
	~	Accumulator (non-negative part of net profit). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Cumulative Discounted Cash Received=
	INTEG (MAX(0, discounted net cash flow), 0)
	~	USD
	~	Accumulator (non-negative part). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

Cumulative Discounted Cash Paid=
	INTEG ((MAX(0, 0 - discounted net cash flow)), 0)
	~	USD
	~	Accumulator (non-negative part). Model: sd-forge car-dealership-profit; structure in 04_stock_flow.md.
	|

shock active=
	IF THEN ELSE(Time >= shock start month, IF THEN ELSE(Time < shock start month + shock duration, 1, 0), 0)
	~	Dmnl
	~	
	|

shoppers=
	Prospects * shopping rate monthly * (1 - demand shock size * shock active)
	~	Household/Month
	~	
	|

new demand=
	shoppers * new share of shoppers
	~	Household/Month
	~	
	|

used demand=
	shoppers * (1 - new share of shoppers) * (1 + discount demand sensitivity * used price discount)
	~	Household/Month
	~	
	|

new sales=
	MIN(new demand * New Inventory / (New Inventory + availability constant new), New Inventory / (minimum sellout time * vehicles per household purchase))
	~	Household/Month
	~	
	|

used sales=
	MIN(used demand * Used Frontline Inventory / (Used Frontline Inventory + availability constant used), Used Frontline Inventory / (minimum sellout time * vehicles per household purchase))
	~	Household/Month
	~	
	|

lease starts=
	new sales * lease share
	~	Household/Month
	~	
	|

retail new buys=
	new sales * (1 - lease share)
	~	Household/Month
	~	
	|

lease stage time=
	lease term / number of lease stages
	~	Month
	~	
	|

lease advance 1=
	Lessees Early / lease stage time
	~	Household/Month
	~	
	|

lease advance 2=
	Lessees Mid / lease stage time
	~	Household/Month
	~	
	|

lease end=
	Lessees Late / lease stage time
	~	Household/Month
	~	
	|

replacement=
	Owners / ownership period
	~	Household/Month
	~	
	|

service ratio=
	Service Customers / MAX(Owners, minimum owner base)
	~	Dmnl
	~	
	|

store loyalty=
	loyalty floor + (loyalty ceiling - loyalty floor) * service ratio / (service ratio + loyalty half saturation)
	~	Dmnl
	~	
	|

repeat to store=
	(replacement + lease end) * store loyalty
	~	Household/Month
	~	
	|

leakage=
	replacement + lease end - repeat to store
	~	Household/Month
	~	
	|

marketing starts=
	maximum marketing starts * (1 - EXP(-marketing spend / marketing spend scale))
	~	Household/Month
	~	
	|

market entries=
	market entry rate
	~	Household/Month
	~	
	|

trade ins=
	replacement * trade in share * vehicles per household purchase
	~	Vehicle/Month
	~	
	|

off lease returns=
	lease end * off lease return share * vehicles per household purchase
	~	Vehicle/Month
	~	
	|

target used inventory=
	used sales * vehicles per household purchase * (target used days supply / days per month + reconditioning time)
	~	Vehicle
	~	
	|

auction buys=
	MAX(0, used sales * vehicles per household purchase + (target used inventory - Used Frontline Inventory - Reconditioning Pipeline) / used inventory adjustment time - trade ins - off lease returns)
	~	Vehicle/Month
	~	
	|

used acquisitions=
	trade ins + off lease returns + auction buys
	~	Vehicle/Month
	~	
	|

recon done=
	Reconditioning Pipeline / reconditioning time
	~	Vehicle/Month
	~	
	|

trailing used change=
	(used sales - Trailing Used Sales) / used sales memory
	~	Household/Month/Month
	~	
	|

used days supply=
	Used Frontline Inventory / MAX(Trailing Used Sales * vehicles per household purchase, minimum used sales rate) * days per month
	~	Day
	~	
	|

used price discount=
	MIN(maximum price discount, discount sensitivity * (used days supply - target used days supply) / target used days supply)
	~	Dmnl
	~	
	|

wholesale exits=
	Used Frontline Inventory * wholesale exit rate monthly * used days supply / target used days supply
	~	Vehicle/Month
	~	
	|

target new inventory=
	new sales * vehicles per household purchase * (target new days supply / days per month + order lead time)
	~	Vehicle
	~	
	|

allocation response=
	allocation response strength * (Trailing New Sales / reference new sales - 1)
	~	Dmnl
	~	
	|

new orders=
	MIN(manufacturer allocation, MAX(0, (new sales * vehicles per household purchase + (target new inventory - New Inventory - New Vehicles On Order) / new inventory adjustment time) * (1 + allocation response)))
	~	Vehicle/Month
	~	
	|

deliveries=
	New Vehicles On Order / order lead time
	~	Vehicle/Month
	~	
	|

trailing change=
	(new sales - Trailing New Sales) / allocation memory
	~	Household/Month/Month
	~	
	|

service capture=
	(new sales + used sales) * service capture share
	~	Household/Month
	~	
	|

capacity=
	Technicians * repairs per technician
	~	RO/Month
	~	
	|

ro demand=
	Service Customers * visits per customer monthly
	~	RO/Month
	~	
	|

utilisation=
	ro demand / capacity
	~	Dmnl
	~	
	|

defection=
	Service Customers * base defection rate monthly * (1 + retention loss when overloaded * (utilisation - 1))
	~	Household/Month
	~	
	|

ro done=
	MIN(ro demand, capacity)
	~	RO/Month
	~	
	|

hiring=
	(technician target - Technicians) / hire time
	~	Technician/Month
	~	
	|

attrition=
	Technicians * attrition rate monthly
	~	Technician/Month
	~	
	|

inventory cost released=
	new sales * vehicles per household purchase * new vehicle unit cost + (used sales * vehicles per household purchase + wholesale exits) * used vehicle unit cost
	~	USD/Month
	~	
	|

floorplan payoff=
	advance rate * inventory cost released
	~	USD/Month
	~	
	|

margin shock factor=
	1 - margin shock size * shock active
	~	Dmnl
	~	
	|

new gross=
	new sales * vehicles per household purchase * new gross per vehicle * margin shock factor
	~	USD/Month
	~	
	|

used gross=
	used sales * vehicles per household purchase * (used gross per vehicle - used price discount * used retail price)
	~	USD/Month
	~	
	|

lease remarketing gain=
	0 - off lease returns * lease remarketing loss per vehicle
	~	USD/Month
	~	
	|

F and I penetration=
	F and I base penetration + F and I maximum penetration uplift * (1 - EXP(-F and I programme spend / F and I spend scale))
	~	Dmnl
	~	
	|

F and I income=
	(new sales + used sales) * F and I penetration * F and I gross per contract * (1 - chargeback rate)
	~	USD/Month
	~	
	|

service gross=
	ro done * gross per repair order
	~	USD/Month
	~	
	|

parts gross=
	ro done * parts gross per repair order
	~	USD/Month
	~	
	|

total gross=
	new gross + used gross + lease remarketing gain + F and I income + service gross + parts gross
	~	USD/Month
	~	
	|

commissions=
	commission rate * (new gross + used gross + F and I income)
	~	USD/Month
	~	
	|

technician payroll=
	Technicians * technician cost monthly
	~	USD/Month
	~	
	|

wholesale loss=
	wholesale exits * wholesale loss per vehicle
	~	USD/Month
	~	
	|

floorplan rate effective=
	floorplan rate monthly + rate shock size / months per year * shock active
	~	1/Month
	~	
	|

floorplan interest=
	Floorplan Debt * floorplan rate effective
	~	USD/Month
	~	
	|

net profit=
	total gross - commissions - marketing spend - F and I programme spend - technician payroll - wholesale loss - fixed overhead - floorplan interest
	~	USD/Month
	~	
	|

net cash flow=
	net profit - (1 - advance rate) * (deliveries * new vehicle unit cost + used acquisitions * used vehicle unit cost - inventory cost released)
	~	USD/Month
	~	
	|

Cash=
	initial cash + Cash Received - Cash Paid Out
	~	USD
	~	
	|

Cumulative Net Profit=
	Cumulative Profit Earned - Cumulative Loss Incurred
	~	USD
	~	
	|

Cumulative Discounted Cash Flow=
	Cumulative Discounted Cash Received - Cumulative Discounted Cash Paid
	~	USD
	~	
	|

discount factor=
	EXP(-discount rate monthly * Time)
	~	Dmnl
	~	
	|

discounted net cash flow=
	net cash flow * discount factor
	~	USD/Month
	~	
	|

absorption rate=
	(service gross + parts gross - technician payroll) / fixed overhead
	~	Dmnl
	~	
	|

floorplan rate monthly=
	floorplan rate / months per year
	~	1/Month
	~	
	|

discount rate monthly=
	discount rate / months per year
	~	1/Month
	~	
	|

shopping rate monthly=
	shopping rate / months per year
	~	1/Month
	~	
	|

base defection rate monthly=
	base defection rate / months per year
	~	1/Month
	~	
	|

attrition rate monthly=
	attrition rate / months per year
	~	1/Month
	~	
	|

wholesale exit rate monthly=
	wholesale exit rate / months per year
	~	1/Month
	~	
	|

visits per customer monthly=
	visits per customer / months per year
	~	RO/(Household*Month)
	~	
	|

technician cost monthly=
	technician cost / months per year
	~	USD/(Technician*Month)
	~	
	|

shopping rate=
	6
	~	1/Year [0,24]
	~	Range 3 to 10, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

new share of shoppers=
	0.55
	~	Dmnl [0.05,0.95]
	~	fixed in the Monte Carlo (a store policy or scenario input); lever range 0.35 to 0.75 for exploration. Confidence: estimated. Source: assumptions_register.md.
	|

market entry rate=
	70
	~	Household/Month [0,1000]
	~	Range 45 to 95, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

maximum marketing starts=
	30
	~	Household/Month [0,500]
	~	Range 15 to 50, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

marketing spend scale=
	20000
	~	USD/Month [100,10000000]
	~	Range 10000 to 50000, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

marketing spend=
	25000
	~	USD/Month [0,10000000]
	~	fixed in the Monte Carlo (a store policy or scenario input); lever range 0 to 60000 for exploration. Confidence: estimated. Source: assumptions_register.md.
	|

availability constant new=
	8
	~	Vehicle [0.5,200]
	~	Range 4 to 16, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

target new days supply=
	60
	~	Day [5,200]
	~	fixed in the Monte Carlo (a store policy or scenario input); lever range 60 to 60 for exploration. Confidence: estimated. Source: assumptions_register.md.
	|

new inventory adjustment time=
	1.5
	~	Month [0.1,24]
	~	Range 1 to 3, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

order lead time=
	1
	~	Month [0.1,12]
	~	Range 0.5 to 2, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

manufacturer allocation=
	160
	~	Vehicle/Month [0,2000]
	~	Range 120 to 220, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

allocation response strength=
	0
	~	Dmnl [0,1]
	~	Range 0 to 0.8, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

allocation memory=
	6
	~	Month [0.5,36]
	~	Range 3 to 12, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

availability constant used=
	8
	~	Vehicle [0.5,200]
	~	Range 4 to 16, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

discount demand sensitivity=
	1.5
	~	Dmnl [0,3]
	~	Range 0.5 to 3, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

discount sensitivity=
	0.15
	~	Dmnl [0,0.3]
	~	Range 0.05 to 0.3, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

maximum price discount=
	0.25
	~	Dmnl [0.05,0.5]
	~	Range 0.15 to 0.35, triangular. Confidence: estimated. Source: assumptions_register.md.
	|

target used days supply=
	45
	~	Day [5,150]
	~	fixed in the Monte Carlo (a store policy or scenario input); lever range 30 to 80 for exploration. Confidence: estimated. Source: assumptions_register.md.
	|

used sales memory=
